      "id": "arxiv:2609.13443",
      "title": "Learning to Solve Hard Problems in RL for LLMs by Never Giving Up",
      "url": "https://arxiv.org/abs/2609.13443",
      "doi": "10.48550/arXiv.2609.13443",
